# CityRide Frontend Environment Variables
# Copy this file to .env and fill in your values.
# DO NOT commit .env to git — it is already in .gitignore.

# Backend API base URL:
# - In local development: http://localhost:5000
# - In Vercel production: leave EMPTY (uses Vercel serverless /api/* automatically)
VITE_API_BASE_URL=http://localhost:5000

# WebSocket URL (only used in local dev — Vercel does not support persistent WebSocket)
# - In local development: ws://localhost:5000
# - In Vercel production: leave EMPTY
VITE_WS_URL=ws://localhost:5000
